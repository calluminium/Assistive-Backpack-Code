// --- Register Tasks --- //
// Keep these Task objects available so the audio announcement uses the
// exact same requiredItems list that is registered with the library.
Task shopsTask{};
Task doctorsTask{};
Task friendHouseTask{};

// This defines what needs to be packed for each task.
void registerPresetTasks() {
  // Button 1: Shops
  shopsTask.type = TaskType::Shops;
  shopsTask.requiredItems[0] = ItemType::Laptop;
  shopsTask.requiredItems[1] = ItemType::Phone;
  shopsTask.requiredItems[2] = ItemType::Keys;
  shopsTask.itemCount = 3;
  shopsTask.reminderAudio = 7;
  backpack.registerTask(shopsTask);

  // Button 2: Doctors
  doctorsTask.type = TaskType::Doctors;
  doctorsTask.requiredItems[0] = ItemType::Wallet;
  //doctorsTask.requiredItems[1] = ItemType::Phone;
  //doctorsTask.requiredItems[2] = ItemType::Medication;
  doctorsTask.itemCount = 1; //change to 3 again later
  doctorsTask.reminderAudio = 4;
  backpack.registerTask(doctorsTask);

  // Button 3: Friend's house
  friendHouseTask.type = TaskType::FriendHouse;
  friendHouseTask.requiredItems[0] = ItemType::Wallet;
  friendHouseTask.requiredItems[1] = ItemType::Phone;
  friendHouseTask.requiredItems[2] = ItemType::Keys;
  friendHouseTask.itemCount = 3;
  friendHouseTask.reminderAudio = 6;
  backpack.registerTask(friendHouseTask);
}

// Announce all items configured for the selected task, then tell the user
// to pack them. Audio file numbers in folder 02 match ItemType values.
void announceTaskItems(TaskType taskType) {
  const Task* selectedTask = nullptr;

  if (taskType == shopsTask.type) {
    selectedTask = &shopsTask;
  } else if (taskType == doctorsTask.type) {
    selectedTask = &doctorsTask;
  } else if (taskType == friendHouseTask.type) {
    selectedTask = &friendHouseTask;
  }

  if (selectedTask == nullptr) {
    return;
  }

  for (uint8_t i = 0; i < selectedTask->itemCount; i++) {
    queueAudio(2, static_cast<uint8_t>(selectedTask->requiredItems[i]));
  }

  // Play after every item name has been queued.
  queueAudio(1, 8);
}


// --- Task Control --- //
// The function implements three possible outcomes:
//   1. If the requested task is already active, stop it.
//   2. If another task is active, refuse to switch and display a warning.
//   3. If no task is active, try to start the requested task.
void startOrStopTask(TaskType requestedTask) {
  if (backpack.isTaskActive()) {
    if (backpack.getCurrentTask() == requestedTask) {
      backpack.stopTask();
    } else {
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Task already on");
      lcd.setCursor(0, 1);
      lcd.print(taskName(backpack.getCurrentTask()));
      ledOrange();
    }

    return;
  }

  if (!backpack.startTask(requestedTask)) {
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Could not start");
    lcd.setCursor(0, 1);
    lcd.print(taskName(requestedTask));
    ledRed();
    return;
  }

  suppressNextItemRequiredAudio = true;
  lastReminderAt = millis();
}


// --- RFID Handling --- //
// Convert the final four UID bytes to the uint32_t tag ID used by Inventory.
// This matches the tag-ID format used by the backpack library.
// ------------------------------- RFID ----------------------------------------

bool sameRFIDTag(const RFIDTagID& a, const RFIDTagID& b)
{
    if (a.length != b.length)
    {
        return false;
    }
    for (uint8_t i = 0; i < a.length; i++)
    {
        if (a.bytes[i] != b.bytes[i])
        {
            return false;
        }
    }
    return true;
}

bool makeRFIDTagID(MFRC522& reader, RFIDTagID& tagID)
{
    uint8_t uidLength = reader.uid.size;

    if (uidLength == 0 || uidLength > MAX_RFID_UID_BYTES)
    {
        return false;
    }

    tagID.length = uidLength;

    for (uint8_t i = 0; i < uidLength; i++)
    {
        tagID.bytes[i] = reader.uid.uidByte[i];
    }

    return true;
}

// Prevent a tag held against a reader from being processed repeatedly.
RFIDTagID lastProcessedTag{};
bool hasLastProcessedTag = false;
unsigned long lastProcessedAt = 0;

const unsigned long RFID_COOLDOWN_MS = 1500;

// --- Admin registration for new RFID tags --- //
// A new/unknown tag opens registration automatically. Choose an item type
// by entering its number in the Serial Monitor (set line ending to Newline).
bool adminRegistrationActive = false;
RFIDTagID pendingTagID{};


// Keep registered tag-to-item mappings across power cycles.
// The user guide documents a maximum inventory capacity of 20 items.
const uint32_t EEPROM_INVENTORY_MAGIC = 0x45534931UL; // "ESI1"
const uint8_t EEPROM_INVENTORY_VERSION = 1;
const uint8_t SAVED_ITEM_LIMIT = 20;

struct SavedRFIDItem {
    uint8_t length;
    uint8_t bytes[MAX_RFID_UID_BYTES];
    uint8_t itemType;
};

struct SavedInventory {
    uint32_t magic;
    uint8_t version;
    uint8_t count;
    SavedRFIDItem items[SAVED_ITEM_LIMIT];
};

SavedInventory savedInventoryData{};

void saveRegisteredItems()
{
    EEPROM.put(0, savedInventoryData);
}

void loadRegisteredItems()
{
    EEPROM.get(0, savedInventoryData);

    if (savedInventoryData.magic != EEPROM_INVENTORY_MAGIC ||
        savedInventoryData.version != EEPROM_INVENTORY_VERSION ||
        savedInventoryData.count > SAVED_ITEM_LIMIT) {
        memset(&savedInventoryData, 0, sizeof(savedInventoryData));
        Serial.println(F("No saved RFID assignments found."));
        return;
    }

    for (uint8_t i = 0; i < savedInventoryData.count; i++) {
        SavedRFIDItem& savedItem = savedInventoryData.items[i];

        if (savedItem.length == 0 ||
            savedItem.length > MAX_RFID_UID_BYTES ||
            savedItem.itemType == 0 ||
            savedItem.itemType > ITEM_CHOICE_COUNT) {
            continue;
        }

        RFIDTagID tagID{};
        tagID.length = savedItem.length;
        for (uint8_t b = 0; b < tagID.length; b++) {
            tagID.bytes[b] = savedItem.bytes[b];
        }

        inventory.registerItem(
            tagID, static_cast<ItemType>(savedItem.itemType));
    }

    Serial.print(F("Loaded saved RFID assignments: "));
    Serial.println(inventory.getItemCount());
}

//FOR TESTING ONLY TO CLEAR VALUES
void clearSavedRFIDItems()
{
    // Clear the saved inventory structure in memory.
    memset(&savedInventoryData, 0, sizeof(savedInventoryData));

    // Write the cleared structure to EEPROM.
    EEPROM.put(0, savedInventoryData);

    Serial.println(F("Saved RFID assignments cleared."));
    Serial.println(F("Restart the Arduino to reload an empty inventory."));
}

void printTagID(const RFIDTagID& tagID)
{
    for (uint8_t i = 0; i < tagID.length; i++) {
        if (tagID.bytes[i] < 0x10) Serial.print('0');
        Serial.print(tagID.bytes[i], HEX);
    }
}

void beginAdminRegistration(const RFIDTagID& tagID) {
  pendingTagID = tagID;
  adminRegistrationActive = true;

  // Start with the first item.
  selectedItemIndex = 0;

  Serial.println();
  Serial.println(F("Unknown RFID tag detected."));
  Serial.print(F("Tag UID: "));
  printTagID(pendingTagID);
  Serial.println();

  Serial.println(F("Use B1 = Up, B2 = Down, B3 = Select"));

  showRegistrationMenu();
}

void finishAdminRegistration() {
  ItemType selectedType = ITEM_CHOICES[selectedItemIndex];

  // Guard against duplicate registration.
  if (inventory.findItem(pendingTagID) != nullptr) {
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Tag registered");
    adminRegistrationActive = false;
    return;
  }

  if (savedInventoryData.count >= SAVED_ITEM_LIMIT) {
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Storage full");

    adminRegistrationActive = false;
    return;
  }

  if (!inventory.registerItem(pendingTagID, selectedType)) {
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Register failed");
    lcd.setCursor(0, 1);
    lcd.print("Try again");

    // Stay in the menu so the user can try selecting again.
    showRegistrationMenu();
    return;
  }

  // Save the RFID tag-to-item mapping.
  SavedRFIDItem& savedItem =
      savedInventoryData.items[savedInventoryData.count++];

  memset(&savedItem, 0, sizeof(savedItem));

  savedItem.length = pendingTagID.length;

  for (uint8_t i = 0; i < pendingTagID.length; i++) {
    savedItem.bytes[i] = pendingTagID.bytes[i];
  }

  savedItem.itemType = static_cast<uint8_t>(selectedType);

  savedInventoryData.magic = EEPROM_INVENTORY_MAGIC;
  savedInventoryData.version = EEPROM_INVENTORY_VERSION;

  saveRegisteredItems();

  // The tag was scanned in the backpack, so mark the item as present.
  backpack.itemAdded(pendingTagID);

  lastProcessedTag = pendingTagID;
  hasLastProcessedTag = true;
  lastProcessedAt = millis();

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Saved item:");
  lcd.setCursor(0, 1);
  lcd.print(itemName(selectedType));

  Serial.print(F("Registered tag as "));
  Serial.println(itemName(selectedType));

  adminRegistrationActive = false;
}

void serviceAdminRegistration() {
  if (!adminRegistrationActive) {
    return;
  }

  // B1: move up through the item list.
  if (buttonPressed(0)) {
    if (selectedItemIndex == 0) {
      selectedItemIndex = ITEM_CHOICE_COUNT - 1;
    } else {
      selectedItemIndex--;
    }

    showRegistrationMenu();
  }

  // B2: move down through the item list.
  if (buttonPressed(1)) {
    selectedItemIndex++;

    if (selectedItemIndex >= ITEM_CHOICE_COUNT) {
      selectedItemIndex = 0;
    }

    showRegistrationMenu();
  }

  // B3: confirm the highlighted item.
  if (buttonPressed(2)) {
    finishAdminRegistration();
  }
}

void handleRFID()
{
    // Pause normal scanning while the user assigns the unknown tag.
    if (adminRegistrationActive) return;
    for (uint8_t i = 0; i < 4; i++)
    {
        if (!readers[i].PICC_IsNewCardPresent() ||
            !readers[i].PICC_ReadCardSerial())
        {
            continue;
        }

        RFIDTagID tagID{};

        if (!makeRFIDTagID(readers[i], tagID))
        {
            readers[i].PICC_HaltA();
            readers[i].PCD_StopCrypto1();
            continue;
        }

        unsigned long now = millis();

        // Ignore the same tag if it was just processed.
        bool duplicate =
            hasLastProcessedTag &&
            sameRFIDTag(tagID, lastProcessedTag) &&
            (now - lastProcessedAt < RFID_COOLDOWN_MS);

        if (!duplicate)
        {
            lastProcessedTag = tagID;
            hasLastProcessedTag = true;
            lastProcessedAt = now;

            Item* item = inventory.findItem(tagID);

            if (item == nullptr)
            {
                // Enter admin registration instead of leaving the tag unknown.
                beginAdminRegistration(tagID);
            }
            else if (item->location == Location::Backpack)
            {
                // The item is currently recorded as inside.
                backpack.itemRemoved(tagID);
            }
            else
            {
                // The item is outside or its location is unknown.
                backpack.itemAdded(tagID);
            }
        }

        readers[i].PICC_HaltA();
        readers[i].PCD_StopCrypto1();

        // Process at most one reader per loop.
        return;
    }
}
// --- Event Handling --- //
// The backpack library generates events when something important happens.
// The backpack responds to those events with user feedback.
void handleEvent(const BackpackEvent& event) {
  switch (event.type) {
    case EventType::TaskStarted:
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print(taskName(event.task));
      lcd.setCursor(0, 1);
      lcd.print("Task selected");
      queueAudio(3, static_cast<uint8_t>(event.task));
      announceTaskItems(event.task);
      ledCyan();
      break;

    case EventType::TaskStopped:
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Task stopped");
      queueAudio(1, 6);
      ledOrange();
      delay(5000);
      showIdleScreen();
      break;

    case EventType::TaskComplete:
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("All items ready!");
      lcd.setCursor(0, 1);
      lcd.print("Ready to go");

      
      queueAudio(1, 7);
      ledGreen();
      break;

    case EventType::ItemRequired:
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Still need:");
      lcd.setCursor(0, 1);
      lcd.print(itemName(event.item));

      // The initial full list has already been announced when the task starts.
      // Suppress the library's first ItemRequired audio to avoid repeating it.
      if (suppressNextItemRequiredAudio) {
        suppressNextItemRequiredAudio = false;
      } else {
        queueAudio(2, static_cast<uint8_t>(event.item));
      }

      ledRed();
      break;

    case EventType::ItemAcquired:
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Added:");
      lcd.setCursor(0, 1);
      lcd.print(itemName(event.item));
      queueAudio(1, 2);
      ledGreen();
      break;

    case EventType::ItemAdded:
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Item added:");
      lcd.setCursor(0, 1);
      lcd.print(itemName(event.item));
      queueAudio(1, 2);
      ledGreen();
      break;

    case EventType::ItemRemoved:
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Item removed:");
      lcd.setCursor(0, 1);
      lcd.print(itemName(event.item));
      queueAudio(1, 5);
      ledOrange();
      break;

    case EventType::ItemNotRequired:
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Not needed:");
      lcd.setCursor(0, 1);
      lcd.print(itemName(event.item));
      queueAudio(1, 3);
      ledPurple();
      break;

    case EventType::UnknownRFID:
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Unknown RFID tag");
      lcd.setCursor(0, 1);
      lcd.print("Choose item type");
      ledPurple();
      break;

    case EventType::TaskReminder:
      queueAudio(4, static_cast<uint8_t>(event.task));
      showTaskScreen();
      break;

    case EventType::ItemAlreadyPresent:
    case EventType::Unknown:
    default:
      break;
  }
}


// Processing Events
void serviceEvents() {
  while (backpack.hasEvent()) {
    BackpackEvent event = backpack.getEvent();
    handleEvent(event);
  }
}

void handleSerialCommands()
{
    if (Serial.available())
    {
        String command = Serial.readStringUntil('\n');
        command.trim();

        if (command.equalsIgnoreCase("RESET"))
        {
            clearSavedRFIDItems();
        }
    }
}

//Sends out reminder to user on what task they are doing
void serviceReminder() {
  if (!backpack.isTaskActive()) {
    return;
  }
  unsigned long now = millis();
  if (now - lastReminderAt >= REMINDER_INTERVAL_MS) {
    lastReminderAt = now;
    BackpackEvent event{};
    event.type = EventType::TaskReminder;
    event.task = backpack.getCurrentTask();
    handleEvent(event);
  }
}

// --- Initialisation --- //
// Configures the serial monitor, buttons, LED outputs, LCD, RFID readers and
// DFPlayer. Starts backpack library, registers the three tasks, displays the
// idle screen and queues the ready-to-go sound.
void setup() {
  Serial.begin(9600);

  pinMode(BUTTON_1_PIN, INPUT_PULLUP);
  pinMode(BUTTON_2_PIN, INPUT_PULLUP);
  pinMode(BUTTON_3_PIN, INPUT_PULLUP);

  pinMode(RGB_RED_PIN, OUTPUT);
  pinMode(RGB_GREEN_PIN, OUTPUT);
  pinMode(RGB_BLUE_PIN, OUTPUT);

  lcd.begin(16, 2);
  lcd.clear();
  lcd.print("Smart Backpack");

  // On the Mega, keep hardware SPI master-select pin 53 as an output.
  pinMode(53, OUTPUT);
  digitalWrite(53, HIGH);

  // Deselect all four RFID readers before starting SPI.
  for (uint8_t i = 0; i < 4; i++) {
    pinMode(RFID_SS_PINS[i], OUTPUT);
    digitalWrite(RFID_SS_PINS[i], HIGH);
  }

  SPI.begin();

  // Keep every reader's SS pin inactive before initializing readers.
  for (uint8_t i = 0; i < 4; i++)
  {
    pinMode(RFID_SS_PINS[i], OUTPUT);
    digitalWrite(RFID_SS_PINS[i], HIGH);
  }

  for (uint8_t i = 0; i < 4; i++)
  {
    readers[i].PCD_Init();
  }

  dfSerial.begin(9600);
  delay(1000);

  if (player.begin(dfSerial, true, true)) {
    dfPlayerReady = true;
    player.volume(22);
    delay(200);
  }

  lastTrackFinishedAt = millis();

  backpack.begin();
  loadRegisteredItems();  // Restore saved RFID-to-item assignments from EEPROM
  registerPresetTasks();
  showIdleScreen();

  queueAudio(1, 7);
}


void loop() {
  handleSerialCommands();
  if (adminRegistrationActive) {
    // During registration, buttons control the item selection menu.
    // Do not interpret them as task-selection buttons.
    serviceAdminRegistration();
  } else {
    // Normal operation: buttons select or stop tasks.
    bool b1 = buttonPressed(0);
    bool b2 = buttonPressed(1);
    bool b3 = buttonPressed(2);

    if (b1) startOrStopTask(TaskType::Shops);
    if (b2) startOrStopTask(TaskType::Doctors);
    if (b3) startOrStopTask(TaskType::FriendHouse);

    // Scan RFID readers only outside registration mode.
    handleRFID();
  }

  // Keep servicing events and audio in both modes.
  serviceEvents();
  serviceReminder();
  serviceAudio();
}
