  004.mp3  Doctors task selected
  005.mp3  Park task selected
  006.mp3  Friend's house task selected
  007.mp3  Shopping task selected

FOLDER 04 - 5-minute reminder "You're doing the <task> task"
  001.mp3  You're doing the University task
  002.mp3  You're doing the Gym task
  003.mp3  You're doing the Work task
  004.mp3  You're doing the Doctors task
  005.mp3  You're doing the Park task
  006.mp3  You're doing the Friend's house task
  007.mp3  You're doing your shopping task

Item and task file numbers must match the enum order in Item.h and Task.h.
If you reorder an enum, renumber the files to match.
*/
// Each queued audio message identifies a folder and file on the SD card.
struct AudioCue {
  uint8_t folder;
  uint8_t file;
};

const uint8_t AUDIO_QUEUE_SIZE = 20;
AudioCue audioQueue[AUDIO_QUEUE_SIZE];

// head = next message to play
// tail = next free position
// count = number of messages waiting in the queue.
uint8_t audioHead = 0, audioTail = 0, audioCount = 0;

// Track playback status and timing for the audio service.
bool audioPlaying = false;
unsigned long audioStartedAt = 0;
unsigned long lastTrackFinishedAt = 0;

// Prevent a failed or unresponsive player from blocking the queue forever
const unsigned long AUDIO_FAILSAFE_MS = 10000UL;

// Wait briefly between tracks to separate spoken messages
const unsigned long TRACK_GAP_MS = 300UL;

// Record whether the DFPlayer initialised successfully
bool dfPlayerReady = false;
// Used to avoid repeating the first required-item announcement.
bool suppressNextItemRequiredAudio = false;

// Add an audio request to the queue if the player is ready,
// the folder and file are valid, and there is space available.
void queueAudio(uint8_t folder, uint8_t file) {
  if (!dfPlayerReady || folder < 1 || folder > 4 || file == 0) {
    return;
  }

  if (audioCount >= AUDIO_QUEUE_SIZE) {
    return;
  }

  audioQueue[audioTail] = {folder, file};
  audioTail = (audioTail + 1) % AUDIO_QUEUE_SIZE;
  audioCount++;
}

// Check player feedback, handle playback timeouts,
// and start the next queued message when playback is idle.
void serviceAudio() {
  if (!dfPlayerReady) {
    return;
  }

  while (player.available()) {
    uint8_t type = player.readType();
    int value = player.read();
    (void)value;

    if (type == DFPlayerPlayFinished || type == DFPlayerError) {
      audioPlaying = false;
      lastTrackFinishedAt = millis();
    }
  }

  if (audioPlaying &&
      millis() - audioStartedAt >= AUDIO_FAILSAFE_MS) {
    audioPlaying = false;
    lastTrackFinishedAt = millis();
  }

  if (!audioPlaying &&
      audioCount > 0 &&
      millis() - lastTrackFinishedAt >= TRACK_GAP_MS) {

    AudioCue cue = audioQueue[audioHead];

    audioHead = (audioHead + 1) % AUDIO_QUEUE_SIZE;
    audioCount--;

    player.playFolder(cue.folder, cue.file);

    audioPlaying = true;
    audioStartedAt = millis();
  }
}


// --- RGB LED --- //
// Common-cathode RGB LED. PWM brightness is kept simple and active-high.
void setRGB(uint8_t r, uint8_t g, uint8_t b) {
  analogWrite(RGB_RED_PIN, r);
  analogWrite(RGB_GREEN_PIN, g);
  analogWrite(RGB_BLUE_PIN, b);
}

void ledBlue()   { setRGB(0, 0, 180); }
void ledCyan()   { setRGB(0, 180, 180); }
void ledRed()    { setRGB(200, 0, 0); }
void ledOrange() { setRGB(220, 70, 0); }
void ledGreen()  { setRGB(0, 180, 0); }
void ledPurple() { setRGB(100, 0, 150); }


// --- Names and UI --- //
// The library represents each item using an enum value, such as ItemType::Laptop.
// The LCD needs a readable string, so this function converts the enum into a name.
const char* itemName(ItemType type) {
  switch (type) {
    case ItemType::Wallet:      return "Wallet";
    case ItemType::Laptop:      return "Laptop";
    case ItemType::Phone:       return "Phone";
    case ItemType::Keys:        return "Keys";
    case ItemType::Charger:     return "Charger";
    case ItemType::WaterBottle: return "Water bottle";
    case ItemType::Medication:  return "Medication";
    case ItemType::Glasses:     return "Glasses";
    case ItemType::Umbrella:    return "Umbrella";
    case ItemType::Book:        return "Book";
    case ItemType::Headphones:  return "Headphones";
    case ItemType::Diary:       return "Diary";
    default:                    return "Unknown item";
  }
}

const char* taskName(TaskType type) {
  switch (type) {
    case TaskType::University: return "University";
    case TaskType::Gym:        return "Gym";
    case TaskType::Work:       return "Work";
    case TaskType::Doctors:    return "Doctors";
    case TaskType::Park:       return "Park";
    default:                   return "No task";
  }
}


