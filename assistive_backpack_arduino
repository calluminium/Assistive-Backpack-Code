// --- Button states --- //
// Store the information needed to detect button presses reliably.
struct ButtonState {
  uint8_t pin;
  bool stableState;
  bool lastReading;
  unsigned long lastChange;
};


ButtonState buttons[3] = {
  {BUTTON_1_PIN, HIGH, HIGH, 0},
  {BUTTON_2_PIN, HIGH, HIGH, 0},
  {BUTTON_3_PIN, HIGH, HIGH, 0}
};

//How long the button needs to be pressed before being accepted
const unsigned long DEBOUNCE_MS = 35;

bool buttonPressed(uint8_t index) {
  // Read the current button state and current time.
  bool reading = digitalRead(buttons[index].pin);
  unsigned long now = millis();

  // If the electrical reading changes, restart the debounce timer.
  if (reading != buttons[index].lastReading) {
    buttons[index].lastChange = now;
    buttons[index].lastReading = reading;
  }

  // Accept the change only after the reading has been stable
  if ((now - buttons[index].lastChange) >= DEBOUNCE_MS &&
      reading != buttons[index].stableState) {
    buttons[index].stableState = reading;

    if (buttons[index].stableState == LOW) {
      return true; // press edge only
    }
  }
  return false;
}


